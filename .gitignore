# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
dist/
build/
*.spec
# ...but these hand-written build inputs are tracked despite the globs above.
!backend/packaging/svr_backend.spec
!frontend/build/
!frontend/build/installer.nsh

# Node / Electron
node_modules/
frontend/dist/
frontend/out/
installer/output/

# Third-party redistributable staged at build time (SDD ADR-6), not committed
installer/vendor/

# Code-signing material - never commit a private key
*.pfx
*.cer
*.p12
*.snk
playwright-report/
test-results/

# Local data
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
local/
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.log

# Claude Code local settings (per-machine)
.claude/settings.local.json

# MS Office lock/owner files
~$*
