{
  "name": "svr-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "SVR Indian Oil Service Station - ElectronJS desktop frontend",
  "author": "SVR Indian Oil Service Station",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "test": "playwright test",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0"
  },
  "build": {
    "extends": null,
    "appId": "in.svr.iocl.station",
    "productName": "SVR IOCL Station",
    "directories": { "output": "../installer/output" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "../backend/packaging/dist/svr-backend", "to": "backend" },
      { "from": "../installer/vendor/tesseract", "to": "tesseract" }
    ],
    "extraFiles": [
      { "from": "../installer/first-run.ps1", "to": "installer/first-run.ps1" },
      { "from": "../installer/uninstall.ps1", "to": "installer/uninstall.ps1" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "sign": "build/sign-hook.js"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SVR-IOCL-Station-Setup-${version}.${ext}"
    }
  }
}
